# Dolby
hal_client_domain(platform_app, hal_dms)

# Platform apps targeting SDK <= 36 (daxService, MotoDolbyDax3) run in
# platform_app_36, which only shares the platform_app_all attribute
allow platform_app_all hal_dms_hwservice:hwservice_manager find;
binder_call(platform_app_all, hal_dms_server)
binder_call(hal_dms_server, platform_app_all)
